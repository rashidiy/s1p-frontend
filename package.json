{
  "name": "s1p-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch:spec": "curl -s http://localhost:8000/openapi.json -o openapi.json",
    "generate:types": "npx openapi-typescript openapi.json -o src/types/generated.ts",
    "generate:types:company": "npx openapi-typescript 'http://localhost:8000/openapi.json?type=company' -o src/types/company.ts",
    "generate:types:owner": "npx openapi-typescript 'http://localhost:8000/openapi.json?type=owner' -o src/types/owner.ts",
    "sync:api": "npm run fetch:spec && npm run generate:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
    "@ant-design/icons": "^6.1.0",
    "@hello-pangea/dnd": "^18.0.1",
    "antd": "^6.3.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.36.0",
    "next": "^15.1.4",
    "next-intl": "^4.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  }
}
